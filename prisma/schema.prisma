generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String?
  price       Float
  images      String[]  // Multiple images ka array
  sizes       String[]  // e.g., ["S", "M", "L", "XL"]
  stock       Int       @default(0)
  isFeatured  Boolean   @default(false)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  reviews     Review[]  // Har product ke multi reviews honge
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Naya Review Model
model Review {
  id        String   @id @default(uuid())
  name      String   // Customer ka naam
  rating    Int      // Rating (1 se 5 stars)
  comment   String   // Review message
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Order {
  id           String      @id @default(uuid())
  customerName String
  phone        String
  address      String
  city         String
  totalAmount  Float
  status       OrderStatus @default(PENDING)
  orderItems   Json        // Cart items ki details JSON format mein store hongi
  createdAt    DateTime    @default(now())
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OfferBanner {
  id        String   @id @default(uuid())
  title     String
  discount  String   // e.g., "Flat 30% OFF"
  image     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}